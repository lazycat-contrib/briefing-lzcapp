{
  "name": "Briefing",
  "package": "cloud.lazycat.app.briefing",
  "description": "安全的直接视频群聊",
  "homepage": "https://github.com/holtwick/briefing",
  "author": "holtwick",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "briefing",
  "version": "3.1.11",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "briefing_8080_8080": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_holtwick_briefing": {
    "originalImage": "holtwick/briefing",
    "pushTarget": "none"
  },
  "briefing_volume_/app/data_action": "emptyDir",
  "briefing_volume_/app/data_location": "app_data"
}
